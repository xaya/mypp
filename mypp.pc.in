prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: @PROJECT_NAME@
Version: @PROJECT_VERSION@

Description: A basic C++ library for interacting with MySQL and MariaDB.
URL: https://github.com/xaya/mypp

Requires: mariadb
Requires.private: libglog

Cflags: -I${includedir}
Libs: -L${libdir} -lmypp
